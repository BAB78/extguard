# Runtime
NODE_ENV=production
PORT=3000
TRUST_PROXY=1
LOG_LEVEL=info

# PostgreSQL (Railway supplies DATABASE_URL when PostgreSQL is attached)
DATABASE_URL=postgresql://user:password@host:5432/extguard
DATABASE_SSL=true

# Stripe; use an all-test or all-live set, never a mixture
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PRICE_ID=price_replace_me
CHECKOUT_SUCCESS_URL=https://example.com/success?session_id={CHECKOUT_SESSION_ID}
CHECKOUT_CANCEL_URL=https://example.com/pricing
BILLING_PORTAL_RETURN_URL=https://example.com/account

# Generate independent high-entropy values. The encryption key must decode to 32 bytes.
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_TTL_SECONDS=86400
LICENSE_KEY_PEPPER=replace-with-another-32-character-random-secret
LICENSE_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key

# Comma-separated browser origins. Requests without an Origin (Stripe/VS Code) are allowed.
CORS_ALLOWED_ORIGINS=https://example.com,https://www.example.com
