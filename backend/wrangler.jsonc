{
  // ExtGuard Team API on Cloudflare Workers.
  //
  // The free plan covers this comfortably: 100,000 requests a day on Workers and 100,000
  // database queries a day through Hyperdrive. A licensing API for a product with tens of
  // customers uses a rounding error of that.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "extguard-api",
  "main": "src/worker.ts",

  // enable_nodejs_http_server_modules is implied by nodejs_compat at this compatibility date,
  // but stating it keeps the requirement visible to anyone reading this file.
  "compatibility_date": "2026-08-04",
  "compatibility_flags": ["nodejs_compat", "enable_nodejs_http_server_modules"],

  "observability": {
    "enabled": true
  },

  // Hyperdrive pools Postgres connections on Cloudflare's side. Workers spin up many isolates,
  // and without pooling each one opens its own connection and exhausts the database's
  // connection limit long before any real traffic arrives.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "REPLACE_WITH_HYPERDRIVE_ID",
      "localConnectionString": "postgresql://postgres:postgres@127.0.0.1:54331/extguard_dev"
    }
  ],

  // Non-secret configuration. Secrets (Stripe keys, JWT secret, licence pepper and encryption
  // key) are set with `wrangler secret put` and never appear in this file.
  "vars": {
    "NODE_ENV": "production",
    "LOG_LEVEL": "info",
    "TRUST_PROXY": "1",
    "DATABASE_SSL": "false",
    "JWT_TTL_SECONDS": "86400"
  }
}
